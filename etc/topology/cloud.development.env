
SDKWORK_MEMORY_DEPLOYMENT_PROFILE=standalone
SDKWORK_MEMORY_ENVIRONMENT=development
SDKWORK_MEMORY_CONFIG_PROFILE=dev
SDKWORK_MEMORY_RUNTIME_TARGET=container
SDKWORK_MEMORY_PROFILE_ID=cloud.development

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_LLM_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_MEMORY_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:8080
SDKWORK_MEMORY_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:8080
SDKWORK_MEMORY_APPLICATION_BACKEND_HTTP_BIND=127.0.0.1:8080
SDKWORK_MEMORY_APPLICATION_BACKEND_HTTP_URL=http://127.0.0.1:8080
SDKWORK_MEMORY_APPLICATION_OPEN_HTTP_BIND=127.0.0.1:8080
SDKWORK_MEMORY_APPLICATION_OPEN_HTTP_URL=http://127.0.0.1:8080
SDKWORK_MEMORY_APPLICATION_APP_HTTP_BIND=127.0.0.1:8080
SDKWORK_MEMORY_APPLICATION_APP_HTTP_URL=http://127.0.0.1:8080

SDKWORK_MEMORY_TENANT_ID=100001
SDKWORK_MEMORY_USER_ID=9001
SDKWORK_MEMORY_DEV_AUTH_BYPASS=true
SDKWORK_MEMORY_SNOWFLAKE_NODE_ID=1
SDKWORK_DATABASE_URL=postgresql://sdkwork_ai_dev:sdkworkdev123@127.0.0.1:5432/sdkwork_ai_dev
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_dev
SDKWORK_LLM_APPLICATION_PUBLIC_HTTP_URL=https://api.sdkwork.com
VITE_SDKWORK_LLM_APPLICATION_PUBLIC_HTTP_URL=https://api.sdkwork.com
SDKWORK_LLM_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com
VITE_SDKWORK_LLM_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com
SDKWORK_LLM_APPLICATION_BACKEND_HTTP_URL=https://api.sdkwork.com
VITE_SDKWORK_LLM_APPLICATION_BACKEND_HTTP_URL=https://api.sdkwork.com
SDKWORK_LLM_APPLICATION_OPEN_HTTP_URL=https://api.sdkwork.com
VITE_SDKWORK_LLM_APPLICATION_OPEN_HTTP_URL=https://api.sdkwork.com
SDKWORK_LLM_APPLICATION_APP_HTTP_URL=https://api.sdkwork.com
VITE_SDKWORK_LLM_APPLICATION_APP_HTTP_URL=https://api.sdkwork.com

# Canonical profile identity (SOURCE_CONFIG_SPEC.md)
SDKWORK_LLM_ENVIRONMENT=development
SDKWORK_LLM_DEPLOYMENT_PROFILE=cloud
SDKWORK_LLM_PROFILE_ID=cloud.development

# dev:cloud local debugging override (vite dev surface only; PNPM_SCRIPT_SPEC section 3).
# The domain edges above stay authoritative for cloud-mode builds and deployed
# services. The development runtime instead binds every gateway-attached base
# URL to the sdkwork-api-cloud-gateway started by its own dev command
# (bind 127.0.0.1:3900), so dev:cloud quick-starts and debugs against the
# local gateway process.
SDKWORK_LOCAL_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900
