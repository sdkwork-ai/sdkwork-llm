# Bootstrap profile standalone.staging — replace with application-specific values.
SDKWORK_LLM_DEPLOYMENT_PROFILE=standalone
SDKWORK_LLM_ENVIRONMENT=staging
SDKWORK_LLM_PROFILE_ID=standalone.staging
SDKWORK_LLM_APPLICATION_PUBLIC_HTTP_URL=https://llm-staging.sdkwork.com
