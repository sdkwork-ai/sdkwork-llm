SDKWORK_MEMORY_DEPLOYMENT_PROFILE=standalone
SDKWORK_MEMORY_ENVIRONMENT=demo
SDKWORK_MEMORY_CONFIG_PROFILE=demo
SDKWORK_MEMORY_RUNTIME_TARGET=container
SDKWORK_MEMORY_PROFILE_ID=standalone.demo
SDKWORK_ENV=demo

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_LLM_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# Dedicated demo ingress bind/ports (kept apart from development 8080 for a distinct demo origin).
SDKWORK_MEMORY_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:8073
SDKWORK_MEMORY_APPLICATION_PUBLIC_HTTP_URL=http://llm-demo.sdkwork.com:8073
SDKWORK_MEMORY_APPLICATION_BACKEND_HTTP_BIND=0.0.0.0:8173
SDKWORK_MEMORY_APPLICATION_BACKEND_HTTP_URL=http://llm-admin-demo.sdkwork.com:8173
SDKWORK_MEMORY_APPLICATION_OPEN_HTTP_BIND=0.0.0.0:8273
SDKWORK_MEMORY_APPLICATION_OPEN_HTTP_URL=http://llm-open-demo.sdkwork.com:8273
SDKWORK_MEMORY_APPLICATION_APP_HTTP_BIND=0.0.0.0:8373
SDKWORK_MEMORY_APPLICATION_APP_HTTP_URL=http://llm-app-demo.sdkwork.com:8373

SDKWORK_MEMORY_TENANT_ID=100001
SDKWORK_MEMORY_USER_ID=9001
SDKWORK_MEMORY_DEV_AUTH_BYPASS=true
SDKWORK_MEMORY_SNOWFLAKE_NODE_ID=1

# Demo database isolation: dedicated schema/user `sdkwork_ai_demo` on the shared Postgres instance,
# fully separate from development `sdkwork_ai_dev`.
SDKWORK_DATABASE_URL=postgresql://sdkwork_ai_demo:sdkworkdemo123@127.0.0.1:5432/sdkwork_ai_demo
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_demo

SDKWORK_LLM_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:8073
SDKWORK_LLM_APPLICATION_PUBLIC_HTTP_URL=http://llm-demo.sdkwork.com:8073
VITE_SDKWORK_LLM_APPLICATION_PUBLIC_HTTP_URL=http://llm-demo.sdkwork.com:8073

# Redis isolation: standalone.demo must use a dedicated Redis logical DB index (e.g. .../9) and an
# `llm-demo` key prefix so shared-Redis rate-limit/idempotency/cache keys never collide with
# dev/test/staging/prod. Provide the concrete REDIS URL through deployment process secrets.

# Canonical profile identity (SOURCE_CONFIG_SPEC.md)
SDKWORK_LLM_ENVIRONMENT=demo
SDKWORK_LLM_DEPLOYMENT_PROFILE=standalone
SDKWORK_LLM_PROFILE_ID=standalone.demo
