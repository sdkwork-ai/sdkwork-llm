SDKWORK_MEMORY_DEPLOYMENT_PROFILE=cloud
SDKWORK_MEMORY_ENVIRONMENT=demo
SDKWORK_MEMORY_CONFIG_PROFILE=demo
SDKWORK_MEMORY_RUNTIME_TARGET=container
SDKWORK_MEMORY_PROFILE_ID=cloud.demo
SDKWORK_ENV=demo

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_LLM_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# Dedicated demo public hosts (see topology.spec.json cloudPublicHosts environments["demo"]).
SDKWORK_LLM_APPLICATION_PUBLIC_HTTP_URL=https://llm-demo.sdkwork.com
VITE_SDKWORK_LLM_APPLICATION_PUBLIC_HTTP_URL=https://llm-demo.sdkwork.com
SDKWORK_LLM_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com
VITE_SDKWORK_LLM_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com
SDKWORK_LLM_APPLICATION_BACKEND_HTTP_URL=https://llm-admin-demo.sdkwork.com
VITE_SDKWORK_LLM_APPLICATION_BACKEND_HTTP_URL=https://llm-admin-demo.sdkwork.com
SDKWORK_LLM_APPLICATION_OPEN_HTTP_URL=https://llm-open-demo.sdkwork.com
VITE_SDKWORK_LLM_APPLICATION_OPEN_HTTP_URL=https://llm-open-demo.sdkwork.com
SDKWORK_LLM_APPLICATION_APP_HTTP_URL=https://llm-app-demo.sdkwork.com
VITE_SDKWORK_LLM_APPLICATION_APP_HTTP_URL=https://llm-app-demo.sdkwork.com

# Demo database isolation: dedicated schema/user `sdkwork_ai_demo` on the shared Postgres instance.
SDKWORK_DATABASE_URL=postgresql://sdkwork_ai_demo:sdkworkdemo123@127.0.0.1:5432/sdkwork_ai_demo
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_demo

# Redis isolation: cloud.demo must use a dedicated Redis logical DB index (e.g. .../9) and an
# `llm-demo` key prefix on the shared Redis so keys never collide with dev/test/staging/prod.
# Provide the concrete REDIS URL through deployment process secrets.

# Canonical profile identity (SOURCE_CONFIG_SPEC.md)
SDKWORK_LLM_ENVIRONMENT=demo
SDKWORK_LLM_DEPLOYMENT_PROFILE=cloud
SDKWORK_LLM_PROFILE_ID=cloud.demo
